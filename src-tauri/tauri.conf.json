{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "edits",
  "version": "0.1.0",
  "identifier": "app.edits.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "edits",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "backgroundColor": "#2b2b2e"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost tile: http://tile.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../vendor/pdfium/bin/pdfium.dll": "pdfium.dll",
      "../vendor/pdfium/LICENSE": "licenses/pdfium-binaries.txt",
      "../vendor/pdfium/licenses/": "licenses/pdfium/",
      "../NOTICE": "NOTICE.txt",
      "../licenses/third-party.txt": "licenses/third-party.txt"
    },
    "licenseFile": "../LICENSE",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "edits.pdf",
        "description": "PDF document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["English", "Arabic"],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzRjA5OThEQzcwNzg1RTEKUldUaGhRZkhqWm53azJLUFZJYVRnOGl0NE1rOXZ1Z0hYc3ZLRW12UUpNZnY3a2ZqRGIwclJKRDIK",
      "endpoints": ["https://github.com/OWNER/edits/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
